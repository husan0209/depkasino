# Базовый URL API (Части 2-4). Если пусто и NEXT_PUBLIC_API_MODE=mock — работает встроенный мок-сервер.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_MODE=mock
# 60 минут ISR для витрины можно переопределить
NEXT_PUBLIC_SITE_NAME=Depkasino
NEXT_PUBLIC_REFERRAL_HOST=https://depkasino.dev

# OAuth-ключи выпускаются на ваш аккаунт и домен (см. docs/integrations.md, раздел 3):
# Google Cloud Console → OAuth client ID (Web), Client Secret — только в секреты бэкенда.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Telegram: @BotFather → /newbot, затем Bot Settings → Domain = боевой домен; bot token — только в бэкенд.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
